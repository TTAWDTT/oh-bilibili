{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BiliMusic",
  "version": "0.1.0",
  "identifier": "dev.bilimusic.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BiliMusic",
        "url": "/",
        "width": 1320,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#050507",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http: https: data: blob:; media-src 'self' asset: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "shortDescription": "Bilibili 音源音乐播放器",
    "icon": ["icons/icon.png"]
  }
}
