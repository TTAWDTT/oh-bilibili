{
  "name": "bilimusic",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run tauri:dev -w @bilimusic/desktop",
    "web": "npm run dev -w @bilimusic/desktop",
    "build": "npm run build -w @bilimusic/desktop",
    "bundle": "npm run tauri:build -w @bilimusic/desktop",
    "typecheck": "npm run typecheck -w @bilimusic/desktop",
    "ui:audit": "node scripts/ui-audit.mjs",
    "fetch:yt-dlp:windows": "node scripts/fetch-yt-dlp-windows.mjs",
    "verify": "cargo test --workspace --locked --quiet && npm run typecheck && npm run ui:audit && node scripts/ipc-audit.mjs",
    "test:sources": "node scripts/sources-test.mjs",
    "test:watch-session": "node scripts/watch-session-test.mjs",
    "test:comment-time": "node scripts/comment-time-test.mjs",
    "test:fav-pages": "node scripts/fav-pages-test.mjs",
    "test:danmaku-merge": "node scripts/danmaku-merge-test.mjs",
    "test:note-reader": "node scripts/note-reader-test.mjs",
    "test:season-mark": "node scripts/season-mark-test.mjs",
    "test:page-spine": "node scripts/page-spine-test.mjs",
    "test:danmaku-filter": "node scripts/danmaku-filter-test.mjs"
  }
}
